# Committed, public-by-design configuration. Every value here is an
# EXPO_PUBLIC_* variable, which Expo inlines into the JS bundle at build time —
# so none of them can be secret, and treating them as if they were is what left
# EXPO_PUBLIC_ASSETS_BASE_URL unset in this tree for the life of the feature.
#
# Real secrets belong in .env.local (gitignored) or EAS secrets, never here.
#
# eas.json carries the same values per build profile. Both exist because they
# answer different questions: eas.json is what a CLOUD BUILD gets, this file is
# what `npx expo start` gets on a fresh clone. A value in one and not the other
# is the shape of bug this file was added to close.

EXPO_PUBLIC_SUPABASE_URL="https://tgbknrmnjwiokraddurx.supabase.co"
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_x_sJn5Q4j3f7GFESXK21wg_Ab2o5sV1"
EXPO_PUBLIC_API_URL="https://monk-learning-api-production.up.railway.app"

# The illustrations bucket. 113 plates live under concept-assets/; without this
# the figure resolver falls back to a single bundled placeholder and every
# labelled_figure board event renders nothing.
EXPO_PUBLIC_ASSETS_BASE_URL="https://pub-03eaaad7d1294d45ab6ae17beecbd799.r2.dev"
